{
  "name": "kankyouken-games",
  "private": true,
  "version": "0.1.0",
  "description": "Reusable kanji/hanzi learning-game mechanics and the games built on them",
  "license": "MIT",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*",
    "data"
  ],
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "build": "npm run build --workspaces --if-present",
    "e2e": "npm run build && playwright test",
    "check": "npm run lint && npm run typecheck && npm run test && npm run build",
    "data": "npm run build --workspace @kankyouken/glyph-data"
  },
  "devDependencies": {
    "@eslint/js": "^9",
    "@playwright/test": "^1.58.2",
    "@types/node": "^22",
    "eslint": "^9",
    "globals": "^16",
    "typescript": "^5",
    "typescript-eslint": "^8",
    "vite": "^8",
    "vitest": "^5",
    "tsx": "^4"
  }
}
